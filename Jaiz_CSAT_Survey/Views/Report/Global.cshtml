@model DashboardViewModel
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
@{
    ViewData["Title"] = "Customer Satisfaction Dashboard";
}

<style>

    .dashboard-card {
        border: none;
        border-radius: 12px;
        transition: .3s;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        }

    .kpi-value {
        font-size: 34px;
        font-weight: 700;
    }

    .kpi-title {
        color: #6c757d;
        font-size: 14px;
    }

    .channel-card {
        border-left: 5px solid #0d6efd;
    }

    .good {
        color: #198754;
        font-weight: bold;
    }

    .average {
        color: #ffc107;
        font-weight: bold;
    }

    .poor {
        color: #dc3545;
        font-weight: bold;
    }

    .table-responsive thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background-color: #f8f9fa;
    }

</style>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="fw-bold">Customer Satisfaction Dashboard</h4>
        </div>
    </div>

    <div class="row mt-4">

        <!-- Branch Performance -->
        <div class="col-lg">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"> Branch Performance</h5>

                    @* <a asp-action="ExportBranchPerformance" asp-controller="Report" class="btn btn-light btn-sm"> <i class="bi bi-file-earmark-excel"></i> Export to Excel </a> *@
                    <form asp-action="ExportBranchPerformance" asp-controller="Report" method="get" class="row g-2 align-items-end">

                        <div class="col-auto">
                            <label class="form-label mb-0">From</label>
                            <input type="date"
                                   name="fromDate"
                                   class="form-control form-control-sm"
                                   value="@Context.Request.Query["fromDate"]" />
                        </div>

                        <div class="col-auto">
                            <label class="form-label mb-0">To</label>
                            <input type="date"
                                   name="toDate"
                                   class="form-control form-control-sm"
                                   value="@Context.Request.Query["toDate"]" />
                        </div>

                        <div class="col-auto">
                            <button type="submit"
                                    class="btn btn-light btn-sm">

                                <i class="bi bi-file-earmark-excel"></i>
                                Export
                            </button>
                        </div>

                    </form>

                </div>

                <div class="card-body">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>#</th>

                                <th>Branch</th>

                                <th>Surveys</th>

                                <th>Average</th>

                                <th>CSAT Score</th>

                                <th>NPS Score</th>

                                <th>Low Ratings</th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int rank = 1;
                            }

                            @foreach (var item in Model.BranchPerformance)
                            {
                                    <tr>

                                        <td>

                                            <span class="badge bg-secondary">

                                            @rank

                                            </span>

                                        </td>

                                        <td>

                                            <strong>@item.BranchName</strong>

                                        </td>

                                        <td>

                                        @item.SurveyCount

                                        </td>

                                        <td>

                                        @item.AverageRating

                                        </td>

                                        <td style="width:220px;">

                                            <div class="d-flex align-items-center">

                                                @* <div class="progress flex-grow-1 me-2">

                                                    <div class="progress-bar
                                                @(item.CSAT >= 90 ? "bg-success"
                                                : item.CSAT >= 75 ? "bg-warning"
                                                : "bg-danger")"
                                                         style="width:@item.CSAT%">
                                                    </div>

                                                </div> *@

                                                @item.CSAT%

                                            </div>

                                        </td>

                                        <td style="width:220px;">

                                            <div class="d-flex align-items-center">

                                                @* <div class="progress flex-grow-1 me-2">

                                                    <div class="progress-bar
                                                @(item.CSAT >= 90 ? "bg-success"
                                                : item.CSAT >= 75 ? "bg-warning"
                                                : "bg-danger")"
                                                         style="width:@item.CSAT%">
                                                    </div>

                                                </div> *@

                                                @item.NPS

                                            </div>

                                        </td>

                                        <td>

                                        @if (item.LowRatings == 0)
                                        {
                                                    <span class="badge bg-success">

                                                        None

                                                    </span>
                                        }
                                        else if (item.LowRatings <= 5)
                                        {
                                                    <span class="badge bg-warning text-dark">

                                                @item.LowRatings

                                                    </span>
                                        }
                                        else
                                        {
                                                    <span class="badge bg-danger">

                                                @item.LowRatings

                                                    </span>
                                        }

                                        </td>

                                    </tr>

                                rank++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

    <div class="row mt-4">

        <!-- Branch CSAT Trend -->
        <div class="col-lg">

            <div class="card shadow-sm">

                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Top Branches by CSAT</h5>
                </div>

                <div class="card-body">

                    <canvas id="branchChart" height="120"></canvas>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <script>


            //============================
            // Branch Ranking
            //============================

            const branchLabels =
            [
        @foreach (var item in Model.BranchPerformance.Take(10))
        {
            <text>'@item.BranchName',</text>
        }
            ];

            const branchValues =
            [
        @foreach (var item in Model.BranchPerformance.Take(10))
        {
            <text>@item.CSAT,</text>
        }
            ];

            new Chart(
            document.getElementById("branchChart"),
            {
                type:'bar',

                data:
                {
                    labels:branchLabels,

                    datasets:
                    [{
                        label:'CSAT %',

                        data:branchValues
                    }]
                },

                options:
                {
                    indexAxis:'y',

                    responsive:true,

                    plugins:
                    {
                        legend:
                        {
                            display:false
                        }
                    },

                    scales:
                    {
                        x:
                        {
                            beginAtZero:true,

                            max:100
                        }
                    }
                }
            });

        </script>

}